# =============================================================================
# BrocheLink — variáveis de ambiente
# Copie para .env.local (desenvolvimento) e cadastre as mesmas na Vercel.
# =============================================================================

# --- Supabase (Project Settings → API) --------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave pública: "anon" (legada) ou "publishable" (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave secreta: "service_role" (legada) ou "secret" (sb_secret_...).
# NUNCA use prefixo NEXT_PUBLIC_ nesta chave. Só o servidor a utiliza.
SUPABASE_SERVICE_ROLE_KEY=

# --- URL pública do app (vai impressa nos QR Codes!) -------------------------
# Defina ANTES de imprimir. Ao trocar para domínio próprio, veja o README.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Segredos (gere com: npm run secrets) -----------------------------------
# Deriva os códigos de ativação. NÃO troque depois de imprimir os cartões.
ACTIVATION_CODE_SECRET=
# "Pepper" do hash armazenado no banco. NÃO troque depois de gerar broches.
ACTIVATION_HASH_PEPPER=
# Sal do hash de IP (estatísticas/rate limit sem guardar IP).
IP_HASH_SALT=

# --- Opcional: Google Safe Browsing (bloqueio de destinos maliciosos) --------
GOOGLE_SAFE_BROWSING_API_KEY=

# --- Limites por operação (não existe limite global de broches) -------------
GENERATION_CHUNK_SIZE=500          # broches por chamada de processamento
MAX_QUANTITY_PER_BATCH=100000      # máximo por lote (crie vários lotes para mais)
EXPORT_MAX_ITEMS=500               # QR Codes por arquivo exportado (PDF/ZIP)
ACTIVATION_MAX_ATTEMPTS=5          # tentativas antes de bloquear a ativação
ACTIVATION_LOCK_SECONDS=900        # bloqueio inicial (dobra a cada reincidência)
SCAN_RATE_LIMIT_PER_MINUTE=60      # leituras contabilizadas por IP por minuto
SCAN_RETENTION_DAYS=365            # retenção sugerida de eventos de leitura
